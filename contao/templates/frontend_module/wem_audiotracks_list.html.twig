{% extends '@Contao/frontend_module/_base.html.twig' %}
{% trans_default_domain 'contao_default' %}

{% block content %}
    <link rel="stylesheet" href="{{ asset('bundles/audiotracks/audiotracks.css') }}">
    <script src="{{ asset('bundles/audiotracks/audiotracks.js') }}" defer></script>

    {% if links|default %}
        <div class="audiotracks__links">
            {% for feed in links %}
                <div class="audiotracks__links__feed">
                    <p>
                        <span class="audiotracks__links__title">{{ feed.title }}</span>
                        {% for link in feed.links %}
                            <a href="{{ link.href }}" title="{{ link.title }}" target="_blank" rel="noopener">{{ link.icon|raw }}</a>
                        {% endfor %}
                    </p>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if add_filters|default %}
        <form method="get">
            <div class="audiotracks__filters" data-container="audioTracks">
                <div class="audiotracks__filters__line">
                    {% for filter in filters %}
                        {% if filter.type == 'select' %}
                            <div class="form-group">
                                <select class="filter" name="{{ filter.name }}"{{ filter.multiple ? ' multiple' }} data-auto-submit>
                                    {% if not filter.multiple %}
                                        <option value="">- {{ filter.label }} -</option>
                                    {% endif %}
                                    {% for option in filter.options %}
                                        <option value="{{ option.value }}"{{ option.selected ? ' selected' }}>{{ option.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% else %}
                            <div class="form-group{{ filter.name == 'search' ? ' form-shrink input-group' }}">
                                <input class="filter" type="text" name="{{ filter.name }}" value="{{ filter.value }}" placeholder="{{ filter.placeholder ?: filter.label }}">
                                {% if filter.name == 'search' %}
                                    <button type="submit" class="squared btn-bg-none" aria-label="{{ filter.label }}"><i class="fal fa-search"></i></button>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </form>
    {% endif %}

    {% set item_template_name = '@Contao/' ~ item_template|default('audiotracks/item') ~ '.html.twig' %}
    {% if items|default is empty %}
        <p class="empty">{{ empty }}</p>
    {% else %}
        <div class="audiotracks" id="audioTracks">
            <div class="table-list" data-responsive="true">
                <table class="table-list__container">
                    <thead>
                        <tr class="table-list__headline">
                            <th data-name="picture"></th>
                            <th data-name="title">{{ 'WEM.AUDIOTRACKS.colTitle'|trans }}</th>
                            <th data-name="duration">{{ 'WEM.AUDIOTRACKS.colDuration'|trans }}</th>
                            <th data-name="date">{{ 'WEM.AUDIOTRACKS.colDate'|trans }}</th>
                            <th data-name="actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            {% include item_template_name with item only %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {{ pagination|default|raw }}

        {% include '@Contao/audiotracks/_player.html.twig' only %}
    {% endif %}
{% endblock %}
