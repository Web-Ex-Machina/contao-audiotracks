{% trans_default_domain 'contao_default' %}

{% if schemaOrg|default %}{% do add_schema_org(schemaOrg) %}{% endif %}
{% set episode_label %}{% if season %}{{ 'WEM.AUDIOTRACKS.seasonShort'|trans }}{{ season }}{% endif %}{% if season and episode %} · {% endif %}{% if episode %}{{ 'WEM.AUDIOTRACKS.episodeShort'|trans }}{{ episode }}{% endif %}{% endset %}

<div class="audiotrack_full{{ class|default('') }}" data-audiotrack="{{ id }}">
    <h1 class="audiotrack__title">{{ title }}</h1>

    {% if picture %}
        <div class="audiotrack__figure img-container">
            <picture>
                {% if pictureMobile|default %}
                    <source media="(max-width: 767px)" srcset="{{ pictureMobile }}">
                {% endif %}
                <img src="{{ picture }}" alt="" loading="lazy">
            </picture>
            {% if pictureText %}
                <div class="audiotrack__figure__text">{{ pictureText|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}</div>
            {% endif %}
        </div>
    {% endif %}

    <div class="audiotrack__content">
        <div class="audiotrack__text">
            {{ description|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}
            <div class="audiotrack__listened">
                <i class="fas fa-circle-check ft-success ft-1-3-em"></i>
                <span>{{ 'WEM.AUDIOTRACKS.listened'|trans }}</span>
            </div>
        </div>
        <div class="audiotrack__actions">
            <button type="button" class="audiotrack__play audiotrack__button"
                data-id="{{ id }}"
                data-title="{{ title }}"
                data-subtitle="{{ episode_label|trim }}"
                data-picture="{{ picture }}"
                data-src="{{ audio }}"
                data-complete="0"
                data-current-time="0"
                data-volume="1"
                aria-label="{{ 'WEM.AUDIOTRACKS.play'|trans }}">
                <i class="fas fa-play"></i><i class="fas fa-pause"></i>
            </button>
            {% if canDownload|default %}
                <a class="audiotrack__download audiotrack__button" href="{{ audio }}" title="{{ 'WEM.AUDIOTRACKS.download'|trans }}" target="_blank" rel="noopener" download><i class="fas fa-download"></i></a>
            {% endif %}
            <button type="button" class="audiotrack__likes audiotrack__button" data-id="{{ id }}" aria-label="{{ 'WEM.AUDIOTRACKS.like'|trans }}">
                <i class="far fa-heart empty"></i>
                <i class="fas fa-heart full"></i>
                <span class="count">{{ nbLikes ?: '' }}</span>
            </button>
            <div class="audiotrack__duration">{{ duration }}</div>
            {% if date %}
                <time class="audiotrack__datetime" datetime="{{ datetime }}">{{ date }}</time>
            {% endif %}
        </div>
    </div>

    <div class="audiotrack__footer">
        <div class="audiotrack__tags">
            {% if tagList|default %}
                <div class="h4 w-100">{{ ('WEM.AUDIOTRACKS.' ~ (tagList|length > 1 ? 'themes' : 'theme'))|trans }}</div>
                {% for tag in tagList %}
                    <span class="tag">{{ tag }}</span>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
