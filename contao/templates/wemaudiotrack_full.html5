<?php 
	$tz = reset(iterator_to_array(IntlTimeZone::createEnumeration('FR')));
	$formatter = IntlDateFormatter::create(
	    'fr_FR',
	    IntlDateFormatter::FULL,
	    IntlDateFormatter::FULL,
	    $tz,
	    IntlDateFormatter::GREGORIAN,
	    'd MMMM Y'
	);
?>
<div class="audiotrack_full <?= $this->class ?>" data-audiotrack="<?= $this->id ?>" itemscope itemtype="http://schema.org/Article">
	<h1 class="audiotrack__title" itemprop="name"><?= $this->title ?></h1>

	<?php if ($this->picture || $this->picture_big): ?>
	<div class="audiotrack__figure m-bottom img-container r_16-9 hidden-sm">
		<?php $this->insert('image', $this->arrData); ?>
		<?php if ($this->pictureText): ?>
			<div class="audiotrack__figure__text"><?= $this->pictureText ?></div>
		<?php endif ?>
	</div>
	<?php endif; ?>

	<?php if ($this->picture || $this->picture_mobile): ?>
	<div class="audiotrack__figure m-bottom img-container r_1-1 hidden visible-sm">
		<?php $this->insert('image', $this->arrData); ?>
	</div>
	<?php endif; ?>

	<div class="audiotrack__content">
		<div class="audiotrack__text">
			<?= $this->description ?>
			<div class="audiotrack__listened<?= array_key_exists('complete', $this->session) ? ' active' : '' ?>"><i class="far fa-check ft-success ft-1-3-em"></i><span><?= $GLOBALS['TL_LANG']['WEM']['AUDIOTRACKS']['listened'] ?></span></div>
		</div>
		<div class="audiotrack__actions">
			<div class="audiotrack__play audiotrack__button" 
				data-id="<?= $this->id ?>" 
				data-title="<?= $this->title ?>" 
				data-src="<?= $this->audio ?>"
				data-complete="<?= array_key_exists('complete', $this->session) ? ' active' : '' ?>"
				data-currentTime="<?= array_key_exists('currentTime', $this->session) ? $this->session['currentTime'] : '' ?>"
				data-volume="<?= array_key_exists('volume', $this->session) ? $this->session['volume'] : '' ?>"
			>
			<i class="fas fa-play"></i><i class="fas fa-pause"></i></div>
			<?php if ($this->canDownload): ?>
			<div class="audiotrack__download audiotrack__button">
				<a href="<?= $this->audio ?>" title="<?= $GLOBALS['TL_LANG']['WEM']['AUDIOTRACKS']['download'] ?>" target="_blank" download><i class="fas fa-download"></i></a>
			</div>
			<?php endif; ?>
			<div class="audiotrack__duration"><?= $this->duration ?></div>
			<?php if ($this->date): ?>
				<div class="audiotrack__datetime"><?php  echo datefmt_format($formatter,$this->date); ?></div>
			<?php endif ?>
		</div>
	</div>

	<div class="audiotrack__footer">
		<div class="audiotrack__tags">
		<?php if (null !== $this->tags && count(deserialize($this->tags))>0): ?>
				<div class="h4 w-100 hidden-sm"><?= $GLOBALS['TL_LANG']['WEM']['AUDIOTRACKS'][count(deserialize($this->tags))>1?'themes':'theme'] ?></div>
				<?php foreach (deserialize($this->tags) as $key => $tag): ?>
					<span class="tag"><?= $tag; ?></span>
				<?php endforeach ?>
		<?php endif ?>
		</div>
		<div class="audiotrack__likes<?= $this->liked?' liked':''; ?>" data-id="<?= $this->id ?>" >
			<i class="fal fa-heart empty"></i>
			<i class="fas fa-heart full"></i>
			<span class="count"><?= $this->nbLikes?:'' ?></span>
		</div>
	</div>
</div>